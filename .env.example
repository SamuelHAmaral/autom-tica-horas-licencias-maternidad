# =============================================================================
# Maternity leave hours → Nodum (copy to .env; never commit .env)
# Production guide: docs/PRODUCTION.md
# =============================================================================

# --- Production gate (recommended on server) ---
# Blocks run if NODUM_DRY_RUN=1 or SYNC_TEST_DATE is set
SYNC_PRODUCTION=1

# --- SQL Server (RRHH) ---
SQL_SERVER_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER_SERVER=your-sql-server.example.com
SQL_SERVER_DATABASE=RRHHAmaral
SQL_SERVER_UID=your_sql_user
SQL_SERVER_PWD=your_sql_password
# Optional ODBC TLS handshake tuning for Linux↔SQL Server compatibility:
# SQL_ENCRYPT=yes
# SQL_ENCRYPT=no
# SQL_TRUST_SERVER_CERTIFICATE=1

SQL_COL_LIC_FECHA_INICIO=fec_inicio
SQL_COL_LIC_FECHA_FIN=fec_final
SQL_COL_TRAB_CENTRO_COSTO=cod_dpto
SQL_COL_TIT_NOMBRE=nom_tit
# SQL_COL_TIT_APELLIDO=
# SQL_COL_FERIADO_FECHA=fecha
# SQL_REQUIRE_TRABAJADOR_ACTIVO=1
# SQL_COL_TRAB_ESTADO=estado_trab
# SQL_TRAB_ESTADO_ACTIVO=A

# ERP catalog on same SQL Server (G2 proyecto maternidad)
AMARAL_CATALOG_DATABASE=amaral01
# MATERNITY_PRY_USE_CABIDRECURSO=1

# --- Nodum SOAP (Amaral01 instance) ---
NODUM_WSDL_URL=http://your-nodum-host:8080/soap/Amaral01/services/forms/v1.3/TpryParteDiaGS?wsdl
NODUM_USERNAME=your_nodum_user
NODUM_PASSWORD=your_nodum_password

# --- Payload (TpryParteDiaGS) ---
NODUM_CODIGO_EMPRESA=01
NODUM_FECHA_DOCUMENTO_STRFTIME=%Y-%m-%d
NODUM_G1_OBSERVACIONES=licencia maternidad automatic
NODUM_G2_CENTRODECOSTO=PRY00380
NODUM_G2_CODIGO_ACTIVIDAD=001
NODUM_G2_HORAS=8
# NODUM_G2_OBSERVACIONES_1=

NODUM_MATERNITY_PROJECT_BY_DEPT=A001=PRY00375,CDE=PRY00376

# --- Run mode (production daily job) ---
NODUM_PARTE_SCOPE=today
NODUM_DRY_RUN=0

NODUM_SOAP_CONNECT_TIMEOUT=30
NODUM_SOAP_READ_TIMEOUT=30
# NODUM_DUPLICATE_OK_SUBSTRINGS=ya existe,duplicado,registro duplicado,parte ya existe

# Backfill watermark (keep default file; do not copy from test env)
# NODUM_BACKFILL_STATE_DISABLE=1
# NODUM_BACKFILL_STATE_FILE=maternity_leave_sync_state.json

# --- Nodum read-back (recommended: skip only maternity proyecto hours) ---
NODUM_READ_WSDL_URL=http://your-nodum-host:8080/soap/Amaral01/services/sim/v1.3/RPryConsHorsxTit?wsdl
# NODUM_READ_USERNAME=
# NODUM_READ_PASSWORD=
NODUM_READ_OPERATION=simular
NODUM_READ_REQUEST_ROOT=RPryConsHorsxTit
NODUM_READ_PARAM_RECURSO=CodigoTitular
NODUM_READ_PARAM_FECHA_DESDE=Dia
NODUM_READ_PARAM_FECHA_HASTA=FechaAuxiliar
NODUM_READ_RECURSO_KEY=R_CodigoTitular
NODUM_READ_FECHA_KEY=R_FechaDocumento
NODUM_READ_HORAS_KEY=R_Cant.Horas
NODUM_READ_CODIGO_ACTIVIDAD_KEY=R_NombredeActividad
NODUM_READ_CENTRO_COSTO_KEY=R_NombreCentrodeCostos
NODUM_READ_FILTER_CODIGO_ACTIVIDAD=
NODUM_READ_FILTER_CENTRO_COSTO=
NODUM_READ_MATCH_RESOLVED_PROYECTO=1
# NODUM_READ_LINE_SUBSTRING_FALLBACK=maternidad

# --- Dev / test only (must be OFF in production) ---
# SYNC_TEST_DATE=2026-03-25
# SYNC_FORCE_RUN=1
