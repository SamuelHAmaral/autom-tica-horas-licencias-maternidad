# SQL Server
SQL_SERVER_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER_SERVER=your-server.example.com
SQL_SERVER_DATABASE=RRHHAmaral
SQL_SERVER_UID=your_sql_user
SQL_SERVER_PWD=your_sql_password

# Nodum SOAP
NODUM_WSDL_URL=https://nodum.example.com/service?wsdl
NODUM_USERNAME=your_nodum_user
NODUM_PASSWORD=your_nodum_password

# Payload defaults
NODUM_FECHA_DOCUMENTO_STRFTIME=%Y-%m-%d
NODUM_G1_OBSERVACIONES=licencia maternidad automatic
NODUM_G2_CENTRODECOSTO=PRY00380
NODUM_G2_CODIGO_ACTIVIDAD=001
NODUM_G2_HORAS=8
# today | week | backfill. Backfill uses maternity_leave_sync_state.json unless NODUM_BACKFILL_STATE_DISABLE=1
NODUM_PARTE_SCOPE=today
# NODUM_BACKFILL_STATE_DISABLE=1
# NODUM_BACKFILL_STATE_FILE=maternity_leave_sync_state.json

# Opcional (ver src/settings.py y README)
# SQL_COL_LIC_FECHA_INICIO=fecha_inicio
# SQL_COL_LIC_FECHA_FIN=fecha_fin
# SQL_COL_TRAB_CENTRO_COSTO=centro_costo
# SQL_COL_TIT_NOMBRE=nom_tit
# SQL_COL_TIT_APELLIDO=
# SQL_REQUIRE_TRABAJADOR_ACTIVO=1
# SQL_COL_TRAB_ESTADO=estado_trab
# SQL_TRAB_ESTADO_ACTIVO=A
# SQL_COL_FERIADO_FECHA=fecha
# SYNC_FORCE_RUN=1
# SYNC_TEST_DATE=2026-03-25
# AMARAL_CATALOG_DATABASE=amaral01
# MATERNITY_PRY_USE_CABIDRECURSO=1
# NODUM_MATERNITY_PROJECT_BY_DEPT=A001=PRY00375,CDE=PRY00376
# NODUM_DRY_RUN=0
# NODUM_SOAP_CONNECT_TIMEOUT=30
# NODUM_SOAP_READ_TIMEOUT=30
# NODUM_DUPLICATE_OK_SUBSTRINGS=ya existe,duplicado
# NODUM_G2_OBSERVACIONES_1=

# Nodum read-back (optional): when configured, script reads already loaded hours in Nodum
# and sends only the missing delta to reach NODUM_G2_HORAS for maternity leave days.
# NODUM_READ_WSDL_URL=https://nodum.example.com/read-service?wsdl
# NODUM_READ_USERNAME=read_user_if_different
# NODUM_READ_PASSWORD=read_password_if_different
# NODUM_READ_OPERATION=consultarPartes
# NODUM_READ_REQUEST_ROOT=RPryConsHorsxTit
# NODUM_READ_PARAM_RECURSO=CodigoIdentificacion
# NODUM_READ_PARAM_FECHA_DESDE=FechaDesde
# NODUM_READ_PARAM_FECHA_HASTA=FechaHasta
